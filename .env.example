HOST=0.0.0.0
PORT=9621

# Явно задаем пути внутри контейнера (чтобы точно совпадали с volume mounts)
INPUT_DIR=/app/data/inputs
WORKING_DIR=/app/data/rag_storage

SUMMARY_LANGUAGE=Ukrainian

# Entity extraction quality controls.
# LightRAG v1.4.16 injects ENTITY_TYPES into the extraction prompt.
ENTITY_TYPES='["LegalAct","Authority","Organization","Person","Role","Document","Form","Procedure","Obligation","Deadline","Concept","DigitalService","Identifier","RegulatoryReference","Event","Location","Product","Service","System","Dataset","Other"]'
MAX_GLEANING=2
CHUNK_SIZE=900
CHUNK_OVERLAP_SIZE=150
OPENAI_LLM_TEMPERATURE=0.2
OPENAI_LLM_MAX_COMPLETION_TOKENS=9000
# Keep extraction cache off while tuning prompts/entity types; enable after baseline is stable.
ENABLE_LLM_CACHE_FOR_EXTRACT=false

# Web UI/API file upload limit (0 = no limits)
MAX_UPLOAD_SIZE=0
# Optional API key for LightRAG HTTP clients. If enabled, set the same value as
# LIGHTRAG_API_KEY in backend/.env.
# LIGHTRAG_API_KEY=your-lightrag-api-key

# Source/relations
MAX_SOURCE_IDS_PER_ENTITY=5000
MAX_SOURCE_IDS_PER_RELATION=3000
MAX_FILE_PATHS=1000
SOURCE_IDS_LIMIT_METHOD=FIFO

# LLM: DeepInfra OpenAI-compatible API
LLM_BINDING=openai
LLM_MODEL=Qwen/Qwen3-14B
LLM_BINDING_HOST=https://api.deepinfra.com/v1/openai
LLM_BINDING_API_KEY=YOUR_DEEPINFRA_TOKEN_HERE

# Embeddings: DeepInfra OpenAI-compatible API
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_BINDING_HOST=https://api.deepinfra.com/v1/openai
EMBEDDING_BINDING_API_KEY=YOUR_DEEPINFRA_TOKEN_HERE
EMBEDDING_SEND_DIM=false

# Базовые параметры
MAX_ASYNC=2
MAX_PARALLEL_INSERT=1

LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lightrag
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DATABASE=lightrag
POSTGRES_MAX_CONNECTIONS=12
POSTGRES_ENABLE_VECTOR=true
POSTGRES_VECTOR_INDEX_TYPE=HNSW_HALFVEC
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200
POSTGRES_IVFFLAT_LISTS=100

NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me_neo4j_password
NEO4J_DATABASE=neo4j
