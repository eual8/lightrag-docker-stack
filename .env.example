HOST=0.0.0.0
PORT=9621

# Явно задаем пути внутри контейнера (чтобы точно совпадали с volume mounts)
INPUT_DIR=/app/data/inputs
WORKING_DIR=/app/data/rag_storage

SUMMARY_LANGUAGE=Ukrainian

# Web UI/API file upload limit (0 = no limits)
MAX_UPLOAD_SIZE=0

# Source/relations
MAX_SOURCE_IDS_PER_ENTITY=5000
MAX_SOURCE_IDS_PER_RELATION=3000
MAX_FILE_PATHS=1000
SOURCE_IDS_LIMIT_METHOD=FIFO

# LLM
LLM_BINDING=openai
LLM_MODEL=gpt-4o
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=

# Embeddings
#EMBEDDING_BINDING=openai
#EMBEDDING_MODEL=text-embedding-3-large
#EMBEDDING_DIM=3072
#EMBEDDING_SEND_DIM=false
#EMBEDDING_BINDING_HOST=https://api.openai.com/v1
#EMBEDDING_BINDING_API_KEY=

### Gemini embedding
EMBEDDING_BINDING=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
EMBEDDING_TOKEN_LIMIT=2048
EMBEDDING_BINDING_HOST=https://generativelanguage.googleapis.com
EMBEDDING_BINDING_API_KEY=
## Gemini embedding requires sending dimension to server
EMBEDDING_SEND_DIM=true

# Базовые параметры
MAX_ASYNC=2
MAX_PARALLEL_INSERT=1

LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lightrag
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DATABASE=lightrag
POSTGRES_MAX_CONNECTIONS=12
POSTGRES_ENABLE_VECTOR=true
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200
POSTGRES_IVFFLAT_LISTS=100

NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me_neo4j_password
NEO4J_DATABASE=neo4j
